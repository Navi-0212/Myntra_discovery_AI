{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://myntradiscoveryai-production.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://myntradiscoveryai-production.up.railway.app/health"
    },
    {
      "source": "/static/:path*",
      "destination": "/static/:path*"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/static/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
